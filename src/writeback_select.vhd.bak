library IEEE;
use IEEE.std_logic_1164.all;

-- Final writeback selector for the Lab 02 / mid-demo datapath.
-- Normal ALU instructions write alu_result.
-- Loads write mem_data.
-- LUI writes the U-type immediate directly.
entity writeback_select is
  port (
    alu_result : in  std_logic_vector(31 downto 0);
    mem_data   : in  std_logic_vector(31 downto 0);
    imm        : in  std_logic_vector(31 downto 0);
    MemToReg   : in  std_logic;
    LUI        : in  std_logic;
    wb_data    : out std_logic_vector(31 downto 0)
  );
end entity;

architecture dataflow of writeback_select is
  signal alu_or_mem : std_logic_vector(31 downto 0);
begin

  alu_or_mem <= mem_data when MemToReg = '1' else alu_result;
  wb_data <= imm when LUI = '1' else alu_or_mem;

end architecture;
